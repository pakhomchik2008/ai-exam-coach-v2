# macOS
.DS_Store
**/.DS_Store

# iCloud Drive conflict copies. This repo lives under ~/Documents, which iCloud
# syncs, and it periodically duplicates files as "name 2.ext" / "name 3.ext".
# 50 of these were committed by accident once; this stops it recurring.
* [0-9].*

# Editor / OS junk
*.swp
Thumbs.db

# Node
node_modules/

# Vite build output
dist/
*.tsbuildinfo

# Test coverage output
coverage/

# Local secrets for scripts/dev-api.mjs (ANTHROPIC_API_KEY, service role key)
.env.local
.env*.local

# Agent worktrees (isolated checkouts for background subagent work)
.claude/worktrees/
test-results/

# Capacitor iOS — App/public is `dist/` copied in by `cap sync`, regenerated
# on every build. Everything else under ios/ (Xcode project, Info.plist,
# entitlements, asset catalog) is real source and stays committed.
ios/App/App/public/
ios/DerivedData/
